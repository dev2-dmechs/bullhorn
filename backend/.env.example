# Copy to backend/.env and fill in. Never commit backend/.env.

# --- Database ---------------------------------------------------------------
# Local Postgres (NOT Docker). Create the database before first run:
#   createdb bullhorn
# The schema is created at app startup. There is no migration step.
DATABASE_URL=postgresql+asyncpg://localhost/bullhorn

# --- Bullhorn ---------------------------------------------------------------
# There is no mock client. Every Bullhorn call below hits the real, live tenant.
# Without these credentials the app starts, but no Bullhorn call will succeed.
#
# The auth and login hosts are NOT set here. They are the same for every Bullhorn
# customer in every region, so they are defaults in app/config.py. They redirect
# to the regional data centre (Goodall Brazier is on EMEA) and the client follows
# that redirect. The per-tenant restUrl is returned by login, not configured.

# --- Bullhorn: Company A (source of vacancies) ------------------------------
BH_A_CLIENT_ID=...
BH_A_CLIENT_SECRET=...
BH_A_USERNAME=...
BH_A_PASSWORD=...
# Display name shown in the UI instead of the generic "Company A" placeholder —
# the tenant's real org name, e.g. its Bullhorn corporate name (example: cmcpartners).
# Optional — defaults to "Company A" if unset. Seeded into the companies table at startup.
BH_A_NAME=cmcpartners

# --- Bullhorn: Company B (source of candidates) -----------------------------
BH_B_CLIENT_ID=...
BH_B_CLIENT_SECRET=...
BH_B_USERNAME=...
BH_B_PASSWORD=...
# Same as BH_A_NAME above. Optional — defaults to "Company B" if unset.
BH_B_NAME=...

# NOTE: the scoping document (§4) also requires a Bullhorn partner/developer
# API key. If that key is passed on API requests rather than only used to
# provision access, it needs a variable here. Confirm with the client.

# --- Deployment ---------------------------------------------------------------
# Comma-separated list of allowed frontend origins for CORS. Defaults to local Vite
# dev only — set to the deployed frontend's origin(s) when running on Vercel.
ALLOWED_ORIGINS=http://localhost:5173

# Set automatically by Vercel (VERCEL=1) — do not set locally. Tells the app to skip
# starting the in-process background job-order poller, which cannot survive a
# serverless function freezing/recycling between invocations. Detection on Vercel
# instead runs via a Vercel Cron Job hitting GET /job-orders/cron/poll.
# VERCEL=1

# Shared secret for the cron-triggered poll endpoint. Set the same value as a Vercel
# project env var named CRON_SECRET — Vercel automatically sends it as
# `Authorization: Bearer $CRON_SECRET` on Cron Job requests. Leave unset locally.
CRON_SECRET=
